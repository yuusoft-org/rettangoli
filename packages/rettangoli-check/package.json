{
  "name": "@rettangoli/check",
  "version": "1.0.0",
  "description": "Static contract checker for Rettangoli projects",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/yuusoft-org/rettangoli",
    "directory": "packages/rettangoli-check"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./cli": "./src/cli/index.js"
  },
  "bin": {
    "rtgl-check": "./src/cli/bin.js"
  },
  "scripts": {
    "ci": "npm run test:no-fe-contracts-import && npm run test:ui-registry-resolution-contract && npm run test:ui-registry-load-contract && npm run test:discovery-symlinks-contract && npm run test:ui-primitive-imported-host-attrs-contract && npm run test:runtime-compatibility && npm run test:scenarios && npm run test:fe-parity && npm run test:listener-issues-contract && npm run test:fuzz-template-pipeline && npm run test:fuzz-jempl-parser && npm run test:jempl-parser-contract && npm run test:scope-graph-range-contract && npm run test:fe-frontend-component-identity-contract && npm run test:fe-frontend-handler-contract && npm run test:fe-frontend-lifecycle-contract && npm run test:fe-frontend-oxc-contract && npm run test:fe-frontend-schema-normalization-contract && npm run test:semantic-engine-contract && npm run test:type-system-contract && npm run test:yahtml-parser-snapshots && npm run test:yahtml-parser-crash && npm run test:fuzz-yahtml-parser && npm run test:fuzz-fe-contract-combinations",
    "test": "npm run ci",
    "test:runtime-compatibility": "node ./scripts/test-runtime-compatibility.js",
    "test:package": "node ./scripts/package-smoke-test.js",
    "test:scenarios": "node ./test/run-scenarios.js",
    "test:fe-parity": "node ./scripts/test-fe-parity.js",
    "test:listener-issues-contract": "node ./scripts/test-listener-issues-contract.js",
    "test:no-fe-contracts-import": "node ./scripts/test-no-fe-contracts-import.js",
    "test:fuzz-template-pipeline": "node ./scripts/fuzz-template-pipeline.js",
    "test:fuzz-jempl-parser": "node ./scripts/fuzz-jempl-parser.js",
    "test:jempl-parser-contract": "node ./scripts/test-jempl-parser-contract.js",
    "test:scope-graph-range-contract": "node ./scripts/test-scope-graph-range-contract.js",
    "test:ui-registry-resolution-contract": "node ./scripts/test-ui-registry-resolution-contract.js",
    "test:ui-registry-load-contract": "node ./scripts/test-ui-registry-load-contract.js",
    "test:discovery-symlinks-contract": "node ./scripts/test-discovery-symlinks-contract.js",
    "test:ui-primitive-imported-host-attrs-contract": "node ./scripts/test-ui-primitive-imported-host-attrs-contract.js",
    "test:fe-frontend-component-identity-contract": "node ./scripts/test-fe-frontend-component-identity-contract.js",
    "test:fe-frontend-handler-contract": "node ./scripts/test-fe-frontend-handler-contract.js",
    "test:fe-frontend-lifecycle-contract": "node ./scripts/test-fe-frontend-lifecycle-contract.js",
    "test:fe-frontend-oxc-contract": "node ./scripts/test-fe-frontend-oxc-contract.js",
    "test:fe-frontend-schema-normalization-contract": "node ./scripts/test-fe-frontend-schema-normalization-contract.js",
    "test:semantic-engine-contract": "node ./scripts/test-semantic-engine-contract.js",
    "test:type-system-contract": "node ./scripts/test-type-system-contract.js",
    "test:yahtml-parser-snapshots": "node ./scripts/test-yahtml-parser-snapshots.js",
    "test:yahtml-parser-crash": "node ./scripts/test-yahtml-parser-crash-containment.js",
    "test:fuzz-yahtml-parser": "node ./scripts/fuzz-yahtml-parser.js",
    "test:fuzz-fe-contract-combinations": "node ./scripts/fuzz-fe-contract-combinations.js"
  },
  "files": [
    "src",
    "README.md",
    "ROADMAP.md",
    "LICENSE"
  ],
  "license": "MIT",
  "dependencies": {
    "@rettangoli/ui": "2.1.0",
    "jempl": "1.0.1",
    "js-yaml": "^4.1.0",
    "oxc-parser": "^0.112.0",
    "yahtml": "0.0.5"
  }
}
