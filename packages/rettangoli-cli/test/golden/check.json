  "check-help": {
    "exitCode": 0,
    "signal": null,
    "stderrHasStack": false,
    "stderrSummary": [],
    "stdout": [
      "Usage: rtgl check [options]",
      "",
      "Run Rettangoli static contract checks",
      "",
      "Options:",
      "  --dir <path>              Component directory to scan (repeatable) (default:",
      "                            [])",
      "  --format <format>         Output format: text, json, or sarif (default:",
      "                            \"text\")",
      "  --warn-as-error           Treat warnings as errors",
      "  --no-yahtml               Disable YAHTML attr/prop validation",
      "  --expr                    Enable expression scope/type checks",
      "  --style                   Enable optional naming and signature conventions",
      "  --watch                   Watch for file changes and re-run checks",
      "  --watch-interval-ms <ms>  Watch poll interval in milliseconds (default: 800)",
      "  -h, --help                display help for command",
      "",
      "",
      "Examples:",
      "  $ rtgl check",
      "  $ rtgl check --dir src/components --format json",
      "  $ rtgl check --warn-as-error",
      "",
      ""
    ],
    "trace": [
      {
        "event": "import",
        "payload": "@rettangoli/check/cli"
      }
    ]
